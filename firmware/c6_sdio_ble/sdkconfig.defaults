# ESP32-C6 only, 4 MiB flash, one large factory image (no OTA requirement).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Own app_main controls Hosted, the SDIO receiver, and local BLE Mesh startup.
CONFIG_ESP_HOSTED_COPROCESSOR=y
CONFIG_ESP_HOSTED_COPROCESSOR_APP_MAIN=n

# C6 is only an SDIO coprocessor transport endpoint here.  Wi-Fi forwarding,
# network split, HTTP examples, and Hosted HCI/BT sharing are intentionally off.
CONFIG_ESP_HOSTED_CP_WIFI=n
CONFIG_ESP_HOSTED_CP_BT=n
CONFIG_ESP_HOSTED_NETWORK_SPLIT_ENABLED=n
CONFIG_ESP_HOSTED_USE_EXAMPLE_WIFI_PRE_PROVISION_CONFIG=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n

# ESP-Hosted 2.12.3 custom RPC over the native C6 SDIO slave.
CONFIG_ESP_HOST_DEV_BOARD_P4_FUNC_BOARD=y
CONFIG_ESP_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_ENABLE_PEER_DATA_TRANSFER=y
CONFIG_ESP_HOSTED_MAX_CUSTOM_MSG_HANDLERS=2
CONFIG_ESP_SDIO_PSEND_PSAMPLE=y

# Bluetooth stays local to the C6.  NimBLE hosts an ESP-BLE-Mesh node; it is
# never exported to the P4 as an HCI controller.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_LE_SCAN_DUPL_TYPE_DATA_DEVICE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_LE_50_FEATURE_SUPPORT=n
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PROVISIONER=n
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_SETTINGS=y
# The image source serializes one 32-segment Access message at a time.  Keep
# the exact 384-byte Upper Transport capacity required by the shared wire ABI.
CONFIG_BLE_MESH_ADV_BUF_COUNT=60
CONFIG_BLE_MESH_TX_SEG_MAX=32
CONFIG_BLE_MESH_RX_SDU_MAX=384
CONFIG_BLE_MESH_TX_SEG_MSG_COUNT=1
CONFIG_BLE_MESH_RX_SEG_MSG_COUNT=1

# Runtime/footprint defaults shared with the upstream 2.12.3 coprocessor.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_ESP_CACHE_MALLOC=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
