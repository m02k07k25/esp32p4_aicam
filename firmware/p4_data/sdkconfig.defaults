CONFIG_SPIRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y

# ESP32-P4-Function-EV-Board flash size. The custom app partition is about 8 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64

# Keep a roomy application partition for the camera and data collection firmware.
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_CAMERA_OV5647=y
# CONFIG_CAMERA_SC2336 is not set
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
# CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS is not set
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
# CONFIG_CAMERA_OV5647_MIPI_RAW8_800X1280_50FPS is not set
# CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS is not set
# CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS is not set
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_IF_FORMAT_INDEX_DEFAULT=2
CONFIG_CAMERA_OV5647_CSI_LINESYNC_ENABLE=y
CONFIG_CAMERA_OV5647_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y

# ESP32-P4 host + ESP32-C6 co-processor over ESP-Hosted SDIO.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y

# Wi-Fi Remote defaults for the C6 co-processor.
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32
# SoftAP data collection does not need Enterprise/EAP and this avoids an
# esp_wifi_remote IDF 5.5 type mismatch when ESP-Hosted is enabled.
# CONFIG_WIFI_RMT_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED is not set
