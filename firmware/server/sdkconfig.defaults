# Board-neutral BLE Mesh Provisioner/Gateway defaults. Select the chip with
# `idf.py set-target`; the project CMake never forces a target.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=n
CONFIG_BLE_MESH_PROVISIONER=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_CFG_CLI=y
CONFIG_BLE_MESH_TX_SEG_MSG_COUNT=10
CONFIG_BLE_MESH_RX_SEG_MSG_COUNT=10
CONFIG_BLE_MESH_RX_SDU_MAX=384
CONFIG_BLE_MESH_ADV_BUF_COUNT=60
CONFIG_BLE_MESH_MAX_PROV_NODES=10
CONFIG_BLE_MESH_WAIT_FOR_PROV_MAX_DEV_NUM=10

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SERVER_SERIAL_IMAGE_ENABLE=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_LIBC_STDOUT_LINE_ENDING_LF=y
