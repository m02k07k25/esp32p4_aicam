menu "Mesh image server"

    config SERVER_MAX_NODES
        int "Maximum provisioned C6 nodes"
        range 1 100
        default 10
        help
            Runtime bookkeeping capacity for newly provisioned C6 sources.
            ESP-BLE-Mesh has its own matching provisioning-node limit.

    config SERVER_FRAME_TIMEOUT_MS
        int "Inactive frame timeout (milliseconds)"
        range 5000 120000
        default 30000
        help
            Abort a frame when no valid OPEN, DATA, or END for this duration.

    config SERVER_TEST_DROP_CHUNK_INDEX
        int "One-shot DATA drop index for NACK testing"
        range -1 82
        default -1
        help
            -1 disables fault injection. Any other value drops that DATA
            chunk once after boot while an active matching frame exists, so
            the following END must produce a bitmap NACK.

    config SERVER_SERIAL_IMAGE_ENABLE
        bool "Framed JPEG records on the console stream"
        default y
        help
            Copy each completed Mesh JPEG into a fixed-capacity queue backed
            by one internal-RAM slot preallocated during startup, and
            transmit it atomically on the same stdout stream as text event
            logs. Use the supplied PC receiver instead of idf.py monitor.
            This image exporter is mutually exclusive with the HTTP exporter,
            but it can run together with SERVER_WIFI_SNTP_ENABLE. A 921600-baud
            console is recommended.

    config SERVER_WIFI_SNTP_ENABLE
        bool "Wi-Fi STA and persistent SNTP server clock"
        depends on SOC_WIFI_SUPPORTED
        default n
        help
            Connect a Wi-Fi-capable server to an access point and maintain its
            Unix wall clock with SNTP. This is independent of the serial and
            HTTP image exporters, so an ESP32-CAM can keep exporting JPEGs on
            UART while it supplies time to C6 nodes. ESP32-H2 excludes this
            source entirely.

    if SERVER_WIFI_SNTP_ENABLE

        config SERVER_WIFI_SSID
            string "Wi-Fi SSID"
            default ""

        config SERVER_WIFI_PASSWORD
            string "Wi-Fi password"
            default ""

        config SERVER_SNTP_SERVER
            string "SNTP server"
            default "pool.ntp.org"

        config SERVER_SNTP_MAX_AGE_MS
            int "Maximum accepted SNTP clock age (milliseconds)"
            range 60000 86400000
            default 7200000
            help
                Stop advertising the wall clock as valid when this much
                monotonic time has elapsed since the last successful SNTP
                update. The two-hour default allows one missed hourly poll
                without distributing a clock that has been offline forever.

    endif

    config SERVER_HTTP_ENABLE
        bool "Latest-image HTTP adapter"
        depends on SOC_WIFI_SUPPORTED && !SERVER_SERIAL_IMAGE_ENABLE
        select SERVER_WIFI_SNTP_ENABLE
        default n
        help
            Optional latest-image exporter for Wi-Fi-capable targets. Wi-Fi
            STA and SNTP are owned by SERVER_WIFI_SNTP_ENABLE, avoiding a
            second network stack initialization. ESP32-H2 excludes this
            source entirely.

    if SERVER_HTTP_ENABLE

        config SERVER_HTTP_PORT
            int "HTTP port"
            range 1 65535
            default 80

    endif

endmenu
