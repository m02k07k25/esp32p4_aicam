CONFIG_SPIRAM=y

CONFIG_CAMERA_SC2336=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_SPIRAM_SPEED_200M=y

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64

# Use a larger app partition for esp-dl + YOLO model in flash rodata.
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Prefer faster YOLO model for HTTP snapshot latency.
# CONFIG_FLASH_COCO_DETECT_YOLO11N_S8_V3 is not set
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V3=y
# CONFIG_COCO_DETECT_YOLO11N_S8_V3 is not set
CONFIG_COCO_DETECT_YOLO11N_320_S8_V3=y
CONFIG_DEFAULT_COCO_DETECT_MODEL=3
